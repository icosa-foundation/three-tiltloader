{
  "name": "three-tiltloader",
  "version": "0.4.2-alpha.4",
  "description": "Load Tilt Brush / Open Brush files in three.js applications",
  "scripts": {
    "watch": "parcel watch --target module",
    "build": "parcel build --no-cache --target module",
    "test": "npm run check:pins && npm run build && node --experimental-strip-types --test test/*.test.mjs",
    "check:pins": "node scripts/check-library-pins.mjs",
    "check:dist": "git diff --exit-code -- dist/three-tiltloader.module.js dist/three-tiltloader.module.js.map",
    "compare:open-brush-fixtures": "node --experimental-strip-types scripts/compare-open-brush-fixtures.mjs",
    "screenshots:brushes": "node scripts/generate-brush-screenshots.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/icosa-gallery/three-tiltloader.git"
  },
  "author": "Icosa Foundation",
  "license": "Apache-2.0",
  "module": "dist/three-tiltloader.module.js",
  "source": "src/TiltLoader.js",
  "types": "src/TiltLoader.d.ts",
  "exports": {
    ".": {
      "types": "./src/TiltLoader.d.ts",
      "import": "./dist/three-tiltloader.module.js",
      "default": "./dist/three-tiltloader.module.js"
    }
  },
  "targets": {
    "types": false,
    "brushScreenshots": {
      "source": "tools/brush-screenshots/index.html",
      "context": "browser"
    }
  },
  "bugs": {
    "url": "https://github.com/icosa-foundation/three-tiltloader/issues"
  },
  "homepage": "https://github.com/icosa-foundation/three-tiltloader#readme",
  "devDependencies": {
    "@parcel/transformer-typescript-types": "^2.12.0",
    "@types/three": "^0.164.1",
    "parcel": "latest",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "three": ">=0.139.0"
  },
  "files": [
    "dist",
    "src/*.d.ts",
    "src/*.d.mts",
    "src/*.js",
    "src/*.ts"
  ],
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/icosa"
  },
  "keywords": [
    "three",
    "three.js",
    "viewer",
    "openbrush",
    "tiltbrush",
    "creative",
    "camera",
    "vr",
    "ar",
    "xr"
  ],
  "dependencies": {
    "three-icosa": "https://github.com/icosa-foundation/three-icosa/archive/25fe4ca1f7e52174e7d9dca90c811e307216ba1f.tar.gz"
  }
}
